<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS1591: missing XML doc — suppressed until documentation pass is complete -->
    <NoWarn>1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>TextAPI.Core</RootNamespace>
    <AssemblyName>TextAPI.Core</AssemblyName>
  </PropertyGroup>
</Project>
